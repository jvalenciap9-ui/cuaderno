# ════════════════════════════════════════════════════
#  Mi Cuaderno — Variables de entorno locales
#  ⚠️ NUNCA subas este archivo a Git (.gitignore lo excluye)
# ════════════════════════════════════════════════════

# ── IA / Gemini ─────────────────────────────────────
# Esta key SOLO la usa el servidor (server/index.ts).
# NUNCA debe ir en el frontend. 
# Obtén tu key en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# ── Servidor proxy ───────────────────────────────────
# Puerto del servidor Express backend (por defecto 3001)
API_PORT=3001

# ── Emuladores Firebase seguros ─────────────────────
# Usa un projectId demo para impedir accesos accidentales a servicios reales.
VITE_EMULATORS=0
VITE_EMULATOR_PROJECT_ID=demo-ediagil
FIREBASE_PROJECT_ID=demo-ediagil

# Endpoint completo opcional de Magia IA para entornos sin rewrite de Hosting.
# En Firebase Hosting se deja vacío para usar /api/gemini.
VITE_GEMINI_PROXY_URL=

# ── App URL (para producción) ────────────────────────
APP_URL=http://localhost:3000

# ── Google Analytics (opcional) ─────────────────────
VITE_GA_MEASUREMENT_ID=

# ── Modo Demo (panel administrativo mock) ────────────
# Cuando VITE_DEMO_MODE=true, la app entra como "admin demo" y TODAS las
# llamadas del panel administrativo (src/lib/adminApi.ts) devuelven datos
# mock en memoria (src/lib/demoAdminData.ts): NO se invocan Cloud Functions
# ni se lee Firestore real. Dataset: 32 docentes, ~60 asignaturas, >120
# estudiantes, discrepancias, métricas y alertas.
#   Activar:   npm run dev:demo        (vite --mode demo; carga .env.demo)
#   Build:     npm run build:demo      (vite build --mode demo)
#   Desactivar: usar npm run dev / npm run build (sin el flag --mode demo).
VITE_DEMO_MODE=

# ════════════════════════════════════════════════════
# INSTRUCCIONES:
# 1. Copia este archivo como .env.local
# 2. Rellena GEMINI_API_KEY con tu clave real
# 3. Para desarrollo, abre DOS terminales:
#    Terminal 1: npm run server   (inicia el proxy de Gemini)
#    Terminal 2: npm run dev      (inicia la app React)
# ════════════════════════════════════════════════════
