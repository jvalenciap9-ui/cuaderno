{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "platform": "gcfv2"
  },
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/gemini",
        "function": "geminiproxy"
      },
      {
        "source": "/api/health",
        "function": "health"
      },
      {
        "source": "/api/lemon-webhook",
        "function": "lemonSqueezyWebhook"
      },
      {
        "source": "/api/create-checkout",
        "function": "createLemonSqueezyCheckout"
      },
      {
        "source": "/api/create-portal",
        "function": "createCustomerPortal"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8081
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
