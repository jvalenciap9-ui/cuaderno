{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx watch server/index.ts",
    "dev:full": "concurrently \"tsx watch server/index.ts\" \"vite --port=3000 --host=0.0.0.0\"",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "deploy": "npm run build:prod && firebase deploy --project ediagil-new-2026",
    "deploy:rules": "firebase deploy --only firestore:rules,storage:rules --project ediagil-new-2026",
    "deploy:indexes": "firebase deploy --only firestore:indexes --project ediagil-new-2026",
    "deploy:hosting": "npm run build:prod && firebase deploy --only hosting --project ediagil-new-2026",
    "deploy:functions": "firebase deploy --only functions --project ediagil-new-2026",
    "deploy:staging": "npm run build:staging && firebase deploy --project ediagil-rc1-staging",
    "deploy:staging:rules": "firebase deploy --only firestore:rules,storage:rules --project ediagil-rc1-staging",
    "deploy:staging:functions": "firebase deploy --only functions --project ediagil-rc1-staging",
    "deploy:staging:hosting": "npm run build:staging && firebase deploy --only hosting --project ediagil-rc1-staging",
    "emulators": "node scripts/run-emulators.mjs",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "test:functions": "node scripts/test-functions.mjs",
    "test:pilot:core": "node scripts/test-pilot-core.mjs",
    "test:pilot:emulators": "node scripts/test-pilot-emulators.mjs",
    "dev:demo": "vite --mode demo --port=3000 --host=0.0.0.0",
    "build:demo": "vite build --mode demo",
    "preview:demo": "vite preview --mode demo"
  },
  "dependencies": {
    "@google/genai": "^1.48.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.3.0",
    "html2canvas-pro": "^2.3.8",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^5.7.284",
    "pm2": "^7.0.1",
    "react": "^19.0.0",
    "react-calendar": "^6.0.0",
    "react-dom": "^19.0.0",
    "react-firebase-hooks": "^5.1.1",
    "react-ga4": "^3.0.1",
    "react-joyride": "^3.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-joyride": "^2.0.2",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
