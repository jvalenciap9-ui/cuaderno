rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Helpers ──
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function existing() { return resource.data; }

    function isExistingOwner() {
      return existing().userId == request.auth.uid;
    }

    // ¿Es el usuario autenticado administrador de la institución dada?
    // role/institutionId solo los escribe el backend (webhook / funciones
    // admin), así que el doc /users es una fuente fiable.
    function isInstitutionAdmin(uid, institutionId) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      return exists(userPath)
        && get(userPath).data.role == 'admin'
        && get(userPath).data.institutionId == institutionId;
    }

    // ── Límite de asignaturas según plan (2 por año natural en el plan free) ──
    // El cliente escribe un contador en /userCounters/{uid} en el MISMO batch
    // que crea/borra la asignatura (ver src/lib/subjectCounter.ts). getAfter()
    // refleja el valor del batch en curso, así las reglas verifican que el
    // contador suba exactamente +1 y que no supere el límite del plan
    // (2 gratis, 999 en Pro/Institucional).
    // Política C8: "2 por año natural" = se cuentan las asignaturas CREADAS en
    // el año calendario actual (campo createdThisYear + yearKey). Borrar una
    // asignatura NO libera cupo del año. Un año nuevo resetea el contador a 1.
    // ⚠️ TEMP-EMULADOR (revertir antes de producción): `request.time.date().year`
    // falla con "Type error: Received [timestamp] Expected [map,path]" en el
    // emulador de Firestore v1.21.0 (en producción Firestore sí lo soporta).
    // Fórmula equivalente con toMillis() que funciona en ambos: para un
    // múltiplo de 4 años desde 1970 la frontera cae EXACTA en 1 Ene 00:00 UTC.
    function currentYearKey() { return string(1970 + int(request.time.toMillis() / 31557600000)); }

    // Helpers de entitlement separados para respetar el máximo de 10
    // variables locales por función de Firestore Rules.
    function profileBlocked(data) {
      return (('disabled' in data) && data.disabled == true)
        || (('isRevoked' in data) && data.isRevoked == true);
    }

    function pilotActiveProfile(data) {
      return ('isPilot' in data)
        && data.isPilot == true
        && ('pilotExpiresAt' in data)
        && data.pilotExpiresAt is number
        && data.pilotExpiresAt > request.time.toMillis();
    }

    function trialOnlyProfile(data) {
      return ('isTrial' in data)
        && data.isTrial == true
        && (!('paymentProvider' in data) || data.paymentProvider == 'trial');
    }

    function trialExpiredProfile(data) {
      return trialOnlyProfile(data)
        && ('trialEndsAt' in data)
        && data.trialEndsAt is number
        && data.trialEndsAt <= request.time.toMillis();
    }

    function trialActiveProfile(data) {
      return trialOnlyProfile(data)
        && ('trialEndsAt' in data)
        && data.trialEndsAt is number
        && data.trialEndsAt > request.time.toMillis();
    }

    function paidPlanExpiredProfile(data) {
      return ('expiresAt' in data)
        && data.expiresAt is number
        && data.expiresAt <= request.time.toMillis();
    }

    function paidPlanActiveProfile(data) {
      return !trialOnlyProfile(data)
        && ('plan' in data)
        && (data.plan == 'pro' || data.plan == 'school')
        && (!('expiresAt' in data) || (data.expiresAt is number && data.expiresAt > request.time.toMillis()));
    }

    function subjectCountWithinLimit() {
      let planPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let counterPath = /databases/$(database)/documents/userCounters/$(request.auth.uid);
      // get()/exists()/existsAfter() son funciones globales de Firestore rules;
      // Resource no tiene método .exists() (eso es de Realtime Database).
      let planDoc = get(planPath);
      // HR-01: si el usuario tiene una prueba que ya expiró, el plan 'pro'
      // prestado por el trial no cuenta a efectos del límite → se trata como free.
      // Un usuario que pagó (paymentProvider distinto de 'trial') nunca se degrada.
      // Los accesos a isTrial/trialEndsAt van precedidos por 'in' porque en
      // CEL, leer una clave inexistente de un map lanza error de evaluación
      // (y niega el write). El documento del cliente normalmente NO trae las
      // claves del trial (son backend-only), así que sin la guardia la creación
      // de una asignatura fallaría para cualquier usuario sin prueba.
      let effectivePlan = planDoc != null
        && (trialExpiredProfile(planDoc.data) || paidPlanExpiredProfile(planDoc.data))
        ? 'free'
        : (planDoc != null ? planDoc.data.plan : null);
      // Un código piloto vigente equivale a Pro tanto para Aula
      // Multiasignatura como para el contador general. Cliente y Rules deben
      // decidir exactamente lo mismo.
      let max = planDoc != null
        && !profileBlocked(planDoc.data)
        && (
          pilotActiveProfile(planDoc.data)
          || effectivePlan == 'pro'
          || effectivePlan == 'school'
        )
        ? 999
        : 2;
      let before = get(counterPath);
      let after = getAfter(counterPath);
      let year = currentYearKey();
      let valid =
        (before != null && after != null
          && after.data.subjectCount == before.data.subjectCount + 1
          && after.data.subjectCount <= max
          && after.data.createdThisYear is number
          && after.data.createdThisYear <= max
          && after.data.yearKey is string
          && (
            // Mismo año calendario: contador de año +1
            (after.data.yearKey == year
              && after.data.yearKey == before.data.yearKey
              && after.data.createdThisYear == before.data.createdThisYear + 1)
            // Año nuevo: reinicia a 1
            || (after.data.yearKey == year
              && after.data.yearKey != before.data.yearKey
              && after.data.createdThisYear == 1)
          ))
        // Primer documento de contador
        || (before == null && after != null
          && after.data.subjectCount == 1
          && after.data.createdThisYear == 1
          && after.data.yearKey == year);
      return valid;
    }

    // ── M1: rate limit de writes al contador (opt-in) ──
    function MAX_WRITES_PER_WINDOW() { return 120; }
    function WINDOW_MS() { return 60000; }

    function writesStartWindow() {
      let now = request.time.toMillis();
      // Tolerancia de clock-skew: el cliente escribe Date.now() (puede ir
      // adelantado vs. request.time). Se admite hasta 60s por delante.
      return request.resource.data.writeWindowStart is number
        && request.resource.data.writes is number
        && request.resource.data.writes == 1
        && request.resource.data.writeWindowStart > now - WINDOW_MS()
        && request.resource.data.writeWindowStart <= now + WINDOW_MS();
    }

    function writesWithinLimit() {
      let now = request.time.toMillis();
      let windowActive = 'writeWindowStart' in resource.data && 'writes' in resource.data
        && resource.data.writeWindowStart is number && resource.data.writes is number
        && resource.data.writeWindowStart + WINDOW_MS() > now;
      return request.resource.data.writeWindowStart is number
        && request.resource.data.writes is number
        && request.resource.data.writes >= 1
        && request.resource.data.writes <= MAX_WRITES_PER_WINDOW()
        && (windowActive
            ? (request.resource.data.writeWindowStart == resource.data.writeWindowStart
                && request.resource.data.writes == resource.data.writes + 1)
            : (request.resource.data.writeWindowStart > now - WINDOW_MS()
                && request.resource.data.writeWindowStart <= now + WINDOW_MS()
                && request.resource.data.writes == 1));
    }

    // ── subjects ──
    match /subjects/{subjectId} {
      function isValidSubject(data) {
        return data.keys().hasAll(['userId', 'name', 'color', 'teacher', 'schedule'])
          && data.userId is string && data.userId == request.auth.uid
          && data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.color is string && data.color.size() > 0 && data.color.size() <= 7
          && data.teacher is string && data.teacher.size() >= 0 && data.teacher.size() <= 200
          && data.schedule is string && data.schedule.size() >= 0 && data.schedule.size() <= 1000;
      }
      allow list: if isSignedIn() && isExistingOwner();
      allow get: if isSignedIn() && isValidId(subjectId) && isExistingOwner();
      // ── Aula/Grupo multiasignatura ──
      // Una materia INTERNA de un aula (groupId apunta a un classGroups
      // propio, modalidad 'varias') NO consume cuota del plan: el AULA
      // completa vale 1 unidad y se descuenta cuando se crea su documento.
      // Si el groupId falta, es inválido o ajeno, la asignatura se trata
      // como independiente y exige su +1 de contador (subjectCountWithinLimit),
      // así que nadie puede eludir el límite inventando grupos.
      function isInternalAulaMateria(data) {
        return ('groupId' in data)
          && data.groupId is string
          && isValidId(data.groupId)
          && (
            exists(/databases/$(database)/documents/classGroups/$(data.groupId))
            || existsAfter(/databases/$(database)/documents/classGroups/$(data.groupId))
          )
          && (
            (exists(/databases/$(database)/documents/classGroups/$(data.groupId)) && get(/databases/$(database)/documents/classGroups/$(data.groupId)).data.userId == request.auth.uid)
            || (existsAfter(/databases/$(database)/documents/classGroups/$(data.groupId)) && getAfter(/databases/$(database)/documents/classGroups/$(data.groupId)).data.userId == request.auth.uid)
          )
          && (
            (exists(/databases/$(database)/documents/classGroups/$(data.groupId)) && get(/databases/$(database)/documents/classGroups/$(data.groupId)).data.modalidad == 'varias')
            || (existsAfter(/databases/$(database)/documents/classGroups/$(data.groupId)) && getAfter(/databases/$(database)/documents/classGroups/$(data.groupId)).data.modalidad == 'varias')
          );
      }
      allow create: if isSignedIn() && isValidId(subjectId) && isValidSubject(request.resource.data)
        && (isInternalAulaMateria(request.resource.data) || subjectCountWithinLimit());
      allow update: if isSignedIn() && isValidId(subjectId) && isExistingOwner() && isValidSubject(request.resource.data);
      allow delete: if isSignedIn() && isValidId(subjectId) && isExistingOwner();
    }

    function canUseMultiSubjectRules() {
      let planPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let planDoc = get(planPath);
      return planDoc != null
        && !profileBlocked(planDoc.data)
        && (
          pilotActiveProfile(planDoc.data)
          || trialActiveProfile(planDoc.data)
          || paidPlanActiveProfile(planDoc.data)
        );
    }

    // ── classGroups (Aula/Grupo multiasignatura) ─────────────────────────
    // Contenedor de varias materias que comparten participantes y asistencia
    // diaria. El docente dueño es el ÚNICO que lee/escribe sus aulas. La
    // creación del aula ocurre en el MISMO batch que sus materias + el
    // contador de unidades (+1 por AULA, no por materia interna — ver
    // src/lib/classGroups.ts). Las asignaturas antiguas NO tienen groupId:
    // son aulas virtuales de una materia y nunca se migran desde aquí.
    match /classGroups/{groupId} {
      function isValidClassGroup(data) {
        return data.keys().hasAll(['userId', 'name', 'modalidad', 'createdAt', 'updatedAt'])
          && data.userId is string && data.userId == request.auth.uid
          && data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.modalidad is string && data.modalidad == 'varias'
          && data.createdAt is number && data.updatedAt is number
          && (!('nivelEducativo' in data) || (data.nivelEducativo is string && data.nivelEducativo.size() <= 40))
          && (!('grado' in data) || (data.grado is string && data.grado.size() <= 60))
          && (!('seccion' in data) || (data.seccion is string && data.seccion.size() <= 60))
          && (!('periodo' in data) || (data.periodo is string && data.periodo.size() <= 40))
          && (!('schemaVersion' in data) || data.schemaVersion is number)
          && (!('planDraft' in data) || (data.planDraft is string && data.planDraft.size() <= 500000))
          && (!('planType' in data) || (data.planType is string && data.planType in ['semanal', 'mensual', 'trimestral']))
          && (!('planStatus' in data) || (data.planStatus is string && data.planStatus in ['idle', 'draft_saved', 'distributed']))
          && (!('lastPlanRunId' in data) || (data.lastPlanRunId is string && data.lastPlanRunId.size() <= 128))
          && (!('unclassifiedItems' in data) || (data.unclassifiedItems is list && data.unclassifiedItems.size() <= 200))
          && (!('originalPlan' in data) || (
            data.originalPlan is map
            && data.originalPlan.keys().hasAll(['content', 'loadedAt', 'version'])
            && data.originalPlan.content is string && data.originalPlan.content.size() <= 500000
            && data.originalPlan.loadedAt is number
            && data.originalPlan.version is number && data.originalPlan.version >= 1
            && (!('fileName' in data.originalPlan) || (data.originalPlan.fileName is string && data.originalPlan.fileName.size() <= 240))
            && (!('fileType' in data.originalPlan) || (data.originalPlan.fileType is string && data.originalPlan.fileType.size() <= 120))
            && (!('format' in data.originalPlan) || (data.originalPlan.format is string && data.originalPlan.format.size() <= 40))
            && (!('scope' in data.originalPlan) || data.originalPlan.scope == 'classGroup')
          ));
      }
      allow list: if isSignedIn() && isExistingOwner();
      allow get: if isSignedIn() && isValidId(groupId) && isExistingOwner();
      allow create: if isSignedIn() && isValidId(groupId) && isValidClassGroup(request.resource.data) && canUseMultiSubjectRules();
      allow update: if isSignedIn() && isValidId(groupId) && isExistingOwner() && isValidClassGroup(request.resource.data) && canUseMultiSubjectRules();
      allow delete: if isSignedIn() && isValidId(groupId) && isExistingOwner();
    }

    // ── userCounters (contador atómico de asignaturas + cuota de writes) ──
    // C8: el contador lleva además de `subjectCount` los campos
    // `createdThisYear` y `yearKey` para el límite "2 por año natural" del
    // plan free. El resto del esquema se mantiene como en C1: el cliente
    // actualiza este doc en el mismo batch que crea/borra una asignatura y la
    // regla exige incrementos/decrementos de a 1 (o reset a 0 cuando se borran
    // todos los datos) para que nadie pueda inflar el contador y eludir el
    // límite de asignaturas.
    match /userCounters/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['subjectCount', 'createdThisYear', 'yearKey', 'updatedAt', 'writes', 'writeWindowStart'])
        && request.resource.data.subjectCount is number
        && (request.resource.data.subjectCount == 1 || request.resource.data.subjectCount == 0)
        && request.resource.data.createdThisYear is number
        && (request.resource.data.createdThisYear == 1 || request.resource.data.createdThisYear == 0)
        && request.resource.data.yearKey is string
        && request.resource.data.yearKey == currentYearKey()
        && ('writes' in request.resource.data ? writesStartWindow() : true);
      // C1: el reset a 0 (borrar todos los datos) SOLO es válido si va
      // acompañado de la instrumentación de rate-limit correcta
      // (writesWithinLimit): así un usuario free no puede resetear el contador
      // a 0 sin instrumentación legítima y eludir el límite de asignaturas
      // creando infinitas con el batch permitido.
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['subjectCount', 'createdThisYear', 'yearKey', 'updatedAt', 'writes', 'writeWindowStart'])
        && request.resource.data.subjectCount is number
        && request.resource.data.subjectCount >= 0
        && request.resource.data.createdThisYear is number
        && request.resource.data.createdThisYear >= 0
        && request.resource.data.yearKey is string
        && (
          // +1: crear asignatura en el mismo año o al arrancar uno nuevo
          (request.resource.data.subjectCount == resource.data.subjectCount + 1
            && (
              (request.resource.data.yearKey == resource.data.yearKey
                && request.resource.data.yearKey == currentYearKey()
                && request.resource.data.createdThisYear == resource.data.createdThisYear + 1)
              || (request.resource.data.yearKey == currentYearKey()
                && request.resource.data.yearKey != resource.data.yearKey
                && request.resource.data.createdThisYear == 1)
            ))
          // -1: borrar asignatura (NO libera cupo del año)
          || (request.resource.data.subjectCount == resource.data.subjectCount - 1
            && request.resource.data.createdThisYear == resource.data.createdThisYear
            && request.resource.data.yearKey == resource.data.yearKey
            && writesWithinLimit())
          // reset a 0: borrar todos los datos (NO libera el cupo del año:
          // createdThisYear se preserva, solo se vacía subjectCount)
          || (request.resource.data.subjectCount == 0
            && request.resource.data.createdThisYear == resource.data.createdThisYear
            && request.resource.data.yearKey == resource.data.yearKey
            && writesWithinLimit())
        );
      allow delete: if false;
    }

    // ── notes ──
    match /notes/{noteId} {
      function isValidNote(data) {
        return data.keys().hasAll(['userId', 'subjectId', 'title', 'content', 'date', 'createdAt', 'updatedAt'])
          && data.userId is string && data.userId == request.auth.uid
          && data.subjectId is string && data.subjectId.size() > 0 && data.subjectId.size() <= 128
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.content is string && data.content.size() >= 0 && data.content.size() <= 300000
          && data.date is string && data.date.size() > 0 && data.date.size() <= 30;
      }
      allow list: if isSignedIn() && isExistingOwner();
      allow get: if isSignedIn() && isValidId(noteId) && isExistingOwner();
      allow create: if isSignedIn() && isValidId(noteId) && isValidNote(request.resource.data)
        && exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId))
        && get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(noteId) && isExistingOwner() && isValidNote(request.resource.data);
      allow delete: if isSignedIn() && isValidId(noteId) && isExistingOwner();
    }

    // ── students ──
    match /students/{studentId} {
      function isValidStudent(data) {
        return data.keys().hasAll(['userId', 'subjectId', 'cedula', 'firstName', 'lastName'])
          && data.userId is string && data.userId == request.auth.uid
          && data.subjectId is string && data.subjectId.size() > 0 && data.subjectId.size() <= 128
          && data.cedula is string && data.cedula.size() > 0 && data.cedula.size() <= 50
          && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100
          && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 100;
      }
      allow list: if isSignedIn() && isExistingOwner();
      allow get: if isSignedIn() && isValidId(studentId) && isExistingOwner();
      allow create: if isSignedIn() && isValidId(studentId) && isValidStudent(request.resource.data)
        && exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId))
        && get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(studentId) && isExistingOwner() && isValidStudent(request.resource.data);
      allow delete: if isSignedIn() && isValidId(studentId) && isExistingOwner();
    }

    // ── evaluations ──
    match /evaluations/{evaluationId} {
      function isValidEvaluation(data) {
        return data.keys().hasAll(['userId', 'subjectId', 'title', 'maxScore', 'date', 'type'])
          && data.userId is string && data.userId == request.auth.uid
          && data.subjectId is string && data.subjectId.size() > 0 && data.subjectId.size() <= 128
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.maxScore is number && data.maxScore >= 0
          && data.date is string && data.date.size() > 0 && data.date.size() <= 30
          && data.type is string && data.type.size() > 0 && data.type.size() <= 50
          && (!('isDraft' in data) || data.isDraft is bool)
          && (!('planRunId' in data) || (data.planRunId is string && data.planRunId.size() <= 128))
          && (!('createdAt' in data) || data.createdAt is number);
      }
      allow list: if isSignedIn() && isExistingOwner();
      allow get: if isSignedIn() && isValidId(evaluationId) && isExistingOwner();
      allow create: if isSignedIn() && isValidId(evaluationId) && isValidEvaluation(request.resource.data)
        && exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId))
        && get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(evaluationId) && isExistingOwner() && isValidEvaluation(request.resource.data);
      allow delete: if isSignedIn() && isValidId(evaluationId) && isExistingOwner();
    }

    // ── grades ──
    match /grades/{gradeId} {
      function isValidGrade(data) {
        return data.keys().hasAll(['userId', 'subjectId', 'evaluationId', 'studentId', 'score'])
          && data.userId is string && data.userId == request.auth.uid
          && data.subjectId is string && data.subjectId.size() > 0 && data.subjectId.size() <= 128
          && data.evaluationId is string && data.evaluationId.size() > 0 && data.evaluationId.size() <= 128
          && data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128
          && data.score is number && data.score >= 0;
      }
      allow list: if isSignedIn() && isExistingOwner();
      allow get: if isSignedIn() && isValidId(gradeId) && isExistingOwner();
      // ── Aula/Grupo multiasignatura: participantes compartidos ──────────
      // En un aula, los students viven UNA sola vez en la asignatura
      // canónica (la más antigua del grupo), pero las notas se registran por
      // MATERIA. La nota es válida si el estudiante pertenece a la misma
      // materia (comportamiento legacy intacto) O si ambas asignaturas son
      // hermanas del MISMO aula del mismo dueño. Nunca cruza docentes ni
      // aulas distintas.
      function sameOwnedClassGroup(canonicalSubjectId, materiaId) {
        let a = get(/databases/$(database)/documents/subjects/$(canonicalSubjectId));
        let b = get(/databases/$(database)/documents/subjects/$(materiaId));
        return a.data.userId == request.auth.uid
          && b.data.userId == request.auth.uid
          && ('groupId' in a.data)
          && a.data.groupId is string
          && a.data.groupId.size() > 0
          && a.data.groupId.size() <= 128
          && isValidId(a.data.groupId)
          && a.data.groupId == b.data.groupId;
      }
      function gradeTargetOk(g) {
        let ev = get(/databases/$(database)/documents/evaluations/$(g.evaluationId));
        let st = get(/databases/$(database)/documents/students/$(g.studentId));
        return ev.data.userId == request.auth.uid
          && ev.data.subjectId == g.subjectId
          && g.score is number
          && g.score <= ev.data.maxScore
          && st.data.userId == request.auth.uid
          && (
            st.data.subjectId == g.subjectId
            || (
              st.data.subjectId is string
              && st.data.subjectId.size() > 0
              && st.data.subjectId.size() <= 128
              && st.data.subjectId != g.subjectId
              && g.subjectId is string
              && sameOwnedClassGroup(st.data.subjectId, g.subjectId)
            )
          );
      }
      allow create: if isSignedIn() && isValidId(gradeId) && isValidGrade(request.resource.data)
        && gradeTargetOk(request.resource.data);
      allow update: if isSignedIn() && isValidId(gradeId) && isExistingOwner() && isValidGrade(request.resource.data)
        && gradeTargetOk(request.resource.data);
      allow delete: if isSignedIn() && isValidId(gradeId) && isExistingOwner();
    }

    // ── attendance ──
    match /attendance/{attendanceId} {
      function isValidAttendance(data) {
        return data.keys().hasAll(['userId', 'subjectId', 'studentId', 'date', 'status'])
          && data.userId is string && data.userId == request.auth.uid
          && data.subjectId is string && data.subjectId.size() > 0 && data.subjectId.size() <= 128
          && data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128
          && data.date is string && data.date.size() > 0 && data.date.size() <= 30
          && data.status is string && data.status.size() > 0 && data.status.size() <= 50;
      }
      allow list: if isSignedIn() && isExistingOwner();
      allow get: if isSignedIn() && isValidId(attendanceId) && isExistingOwner();
      allow create: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(request.resource.data)
        && exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId))
        && get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(attendanceId) && isExistingOwner() && isValidAttendance(request.resource.data);
      allow delete: if isSignedIn() && isValidId(attendanceId) && isExistingOwner();
    }

    // ── calendarEvents ──
    match /calendarEvents/{calendarEventId} {
      function isValidCalendarEvent(data) {
        return data.keys().hasAll(['userId', 'subjectId', 'title', 'date', 'type'])
          && data.userId is string && data.userId == request.auth.uid
          && data.subjectId is string && data.subjectId.size() > 0 && data.subjectId.size() <= 128
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.date is string && data.date.size() > 0 && data.date.size() <= 30
          && data.type is string && data.type.size() > 0 && data.type.size() <= 50;
      }
      allow list: if isSignedIn() && isExistingOwner();
      allow get: if isSignedIn() && isValidId(calendarEventId) && isExistingOwner();
      allow create: if isSignedIn() && isValidId(calendarEventId) && isValidCalendarEvent(request.resource.data)
        && exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId))
        && get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(calendarEventId) && isExistingOwner() && isValidCalendarEvent(request.resource.data);
      allow delete: if isSignedIn() && isValidId(calendarEventId) && isExistingOwner();
    }

    // ── materials ──
    match /materials/{materialId} {
      function isValidMaterial(data) {
        return data.keys().hasAll(['userId', 'subjectId', 'title', 'type', 'date'])
          && data.userId is string && data.userId == request.auth.uid
          && data.subjectId is string && data.subjectId.size() > 0 && data.subjectId.size() <= 128
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.type is string && data.type.size() > 0 && data.type.size() <= 50
          && data.date is string && data.date.size() > 0 && data.date.size() <= 30;
      }
      allow list: if isSignedIn() && isExistingOwner();
      allow get: if isSignedIn() && isValidId(materialId) && isExistingOwner();
      allow create: if isSignedIn() && isValidId(materialId) && isValidMaterial(request.resource.data)
        && exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId))
        && get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(materialId) && isExistingOwner() && isValidMaterial(request.resource.data);
      allow delete: if isSignedIn() && isValidId(materialId) && isExistingOwner();
    }

    // ── subjectModules ──
    match /subjectModules/{subjectModuleId} {
      function isValidSubjectModule(data) {
        return data.keys().hasAll(['userId', 'subjectId', 'title', 'order', 'createdAt'])
          && data.userId is string && data.userId == request.auth.uid
          && data.subjectId is string && data.subjectId.size() > 0 && data.subjectId.size() <= 128
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.order is number
          && data.createdAt is number
          && (!('assignedSubjectId' in data) || data.assignedSubjectId == null || (data.assignedSubjectId is string && data.assignedSubjectId.size() > 0 && data.assignedSubjectId.size() <= 128))
          && (!('classGroupId' in data) || (data.classGroupId is string && data.classGroupId.size() > 0 && data.classGroupId.size() <= 128))
          && (!('scope' in data) || data.scope in ['classGroup', 'subject'])
          && (!('planRunId' in data) || (data.planRunId is string && data.planRunId.size() <= 128));
      }
      function assignmentTargetOk(data) {
        return !('assignedSubjectId' in data) || data.assignedSubjectId == null || (
          ('classGroupId' in data)
          && data.classGroupId is string
          && exists(/databases/$(database)/documents/subjects/$(data.assignedSubjectId))
          && get(/databases/$(database)/documents/subjects/$(data.assignedSubjectId)).data.userId == request.auth.uid
          && ('groupId' in get(/databases/$(database)/documents/subjects/$(data.assignedSubjectId)).data)
          && get(/databases/$(database)/documents/subjects/$(data.assignedSubjectId)).data.groupId == data.classGroupId
          && ('groupId' in get(/databases/$(database)/documents/subjects/$(data.subjectId)).data)
          && get(/databases/$(database)/documents/subjects/$(data.subjectId)).data.groupId == data.classGroupId
        );
      }
      allow list: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow get: if isSignedIn() && isValidId(subjectModuleId) && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && isValidId(subjectModuleId) && isValidSubjectModule(request.resource.data)
        && exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId))
        && get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.userId == request.auth.uid
        && assignmentTargetOk(request.resource.data);
      allow update: if isSignedIn() && isValidId(subjectModuleId) && request.auth.uid == resource.data.userId
        && isValidSubjectModule(request.resource.data) && assignmentTargetOk(request.resource.data);
      allow delete: if isSignedIn() && isValidId(subjectModuleId) && request.auth.uid == resource.data.userId;
    }

    // ── licenseKeys ──
    // Ningún cliente puede leer claves directamente (antes cualquiera autenticado
    // podía leer cualquier clave). El único camino válido es la Cloud Function
    // `redeemLicenseKey` (bypassa las reglas de forma segura).
    match /licenseKeys/{keyId} {
      allow get: if false;
      allow list, write: if false;
    }

    // ── institutions / institutionUsers (plan school) ──
    // El backend (webhook de Lemon Squeezy) crea la institución y la
    // membresía admin. Los administradores pueden crear membresías de
    // docentes directamente desde el cliente (invitación) y leer las de su
    // institución; cada docente lee la suya propia.
    match /institutions/{institutionId} {
      allow read: if isSignedIn()
        && exists(/databases/$(database)/documents/institutionUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/institutionUsers/$(request.auth.uid)).data.institutionId == institutionId;
      allow write: if false;
    }

    match /institutionUsers/{membershipId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || isInstitutionAdmin(request.auth.uid, resource.data.institutionId)
      );
      allow list: if false;
      // Los admins crean miembros (solo rol teacher), nunca admins, y solo
      // dentro de SU institución. El id del doc debe coincidir con el userId
      // (invariante usado por garantizar idempotencia y por las reglas).
      allow create: if isSignedIn()
        && request.resource.data.userId is string
        && request.resource.data.userId == membershipId
        && request.resource.data.role == 'teacher'
        && request.resource.data.institutionId is string
        && isInstitutionAdmin(request.auth.uid, request.resource.data.institutionId);
      // update/delete: lo gestiona el backend (quitar/editar docentes) para no
      // desincronizar users.institutionId, que el cliente no puede cambiar.
      allow update, delete: if false;
    }

    // ── userSettings (ponderaciones, escala, etc.) ──
    match /userSettings/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── observations (boletín v2: observaciones del consejero y docentes) ──
    // Cada observación pertenece a su AUTOR (el docente que la escribe). La
    // lectura está abierta al autor y a cualquier miembro de la MISMA
    // institución (para que el admin consolide el boletín vía Cloud Function
    // y los colegas de institución puedan verlas). La escritura (crear/
    // actualizar/borrar) solo del autor.
    function isSameInstitutionAsAuthor() {
      let authorPath = /databases/$(database)/documents/institutionUsers/$(resource.data.userId);
      let readerPath = /databases/$(database)/documents/institutionUsers/$(request.auth.uid);
      return exists(authorPath)
        && exists(readerPath)
        && get(authorPath).data.institutionId == get(readerPath).data.institutionId;
    }

    match /observations/{observationId} {
      function isValidObservation(data) {
        return data.keys().hasAll(['userId', 'studentId', 'subjectId', 'period', 'text', 'updatedAt'])
          && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
          && data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 128
          && data.subjectId is string && data.subjectId.size() <= 128
          && data.period is string && data.period.size() > 0 && data.period.size() <= 32
          && data.text is string && data.text.size() >= 0 && data.text.size() <= 3000
          && data.updatedAt is number;
      }
      allow read: if isSignedIn() && isValidId(observationId) && (
        resource.data.userId == request.auth.uid
        || isSameInstitutionAsAuthor()
      );
      allow create: if isSignedIn() && isValidId(observationId)
        && isValidObservation(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(observationId)
        && isValidObservation(request.resource.data)
        && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(observationId)
        && resource.data.userId == request.auth.uid;
    }

    // ── users ──
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      // Los campos sensibles (role, institutionId, institutionName, plan) solo
      // los puede escribir el backend (webhook / Cloud Functions). El cliente
      // crea su perfil con plan free y role teacher por defecto.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['plan', 'email', 'createdAt'])
        && request.resource.data.plan == 'free'
        && (!('role' in request.resource.data) || request.resource.data.role == 'teacher')
        && !('institutionId' in request.resource.data)
        && !('institutionName' in request.resource.data)
        && !('isTrial' in request.resource.data)
        && !('trialEndsAt' in request.resource.data)
        && !('trialUsed' in request.resource.data)
        && !('trialStartedAt' in request.resource.data)
        && !('isPilot' in request.resource.data)
        && !('pilotExpiresAt' in request.resource.data)
        && !('disabled' in request.resource.data)
        && !('isRevoked' in request.resource.data)
        && request.resource.data.aiCallsThisMonth is number
        && request.resource.data.aiCallsThisMonth == 0;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.plan == existing().plan
        && request.resource.data.aiCallsThisMonth == existing().aiCallsThisMonth
        && (!('role' in request.resource.data) || request.resource.data.role == existing().role)
        && (!('institutionId' in request.resource.data) || request.resource.data.institutionId == existing().institutionId)
        && (!('institutionName' in request.resource.data) || request.resource.data.institutionName == existing().institutionName)
        // HR-01/integración: los campos de trial son propiedad exclusiva del
        // backend (activateTrial / resolveTrialExpiry / webhooks). El cliente
        // no puede escribirlos ni auto-concederse una prueba. Se usa diff()
        // sobre los campos EFECTIVAMENTE CAMBIADOS para no bloquear writes
        // legítimos del cliente (p.ej. lastLoginAt) a docs que ya contienen
        // campos trial escritos por el backend.
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isTrial', 'trialEndsAt', 'trialUsed', 'trialStartedAt', 'isPilot', 'pilotExpiresAt', 'disabled', 'isRevoked']);

      allow delete: if false;
    }
  }
}
